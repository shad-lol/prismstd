public func add(_ other: Float64, to: Float64) { to = to + other }

public func subtract(_ other: Float64, from: Float64) { from = from - other }

public func multiply(_ float: Float64, by: Float64) { float = float * by }

public func divide(_ float: Float64, by: Float64) { float = float / by }



module Float64 {

	0: data: @f64



	public func plus(_ other: Float64) -> Float64 { return @f64_plus(data, other.data) }

	public func minus(_ other: Float64) -> Float64 { return @f64_minus(data, other.data) }

	public func times(_ other: Float64) -> Float64 { return @f64_times(data, other.data) }

	public func divided(by: Float64) -> Float64 { return @f64_divided_by(data, other.data) }



	operator +  (_ other: Float64) -> Float64 { return self.plus(other) }
	operator += (_ other: Float64) { add(other, to: self) }

	operator -  (_ other: Float64) -> Float64 { return self.minus(other) }
	operator -= (_ other: Float64) { subtract(other, from: self) }

	operator *  (_ other: Float64) -> Float64 { return self.times(other) }
	operator *= (_ other: Float64) { multiply(self, by: other) }

	operator /  (_ other: Float64) -> Float64 { return self.divided(by: other) }
	operator /= (_ other: Float64) { divide(self, by: other) }

}