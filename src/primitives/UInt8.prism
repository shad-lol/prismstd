public func add(_ other: UInt8, to: UInt8) { to = to + other }

public func subtract(_ other: UInt8, from: UInt8) { from = from - other }

public func multiply(_ float: UInt8, by: UInt8) { float = float * by }

public func divide(_ float: UInt8, by: UInt8) { float = float / by }



module UInt8 {

	0: data: @u8



	public func plus(_ other: UInt8) -> UInt8 { return @u8_plus(data, other.data) }

	public func minus(_ other: UInt8) -> UInt8 { return @u8_minus(data, other.data) }

	public func times(_ other: UInt8) -> UInt8 { return @u8_times(data, other.data) }

	public func divided(by: UInt8) -> UInt8 { return @u8_divided_by(data, other.data) }



	operator +  (_ other: UInt8) -> UInt8 { return self.plus(other) }
	operator += (_ other: UInt8) { add(other, to: self) }

	operator -  (_ other: UInt8) -> UInt8 { return self.minus(other) }
	operator -= (_ other: UInt8) { subtract(other, from: self) }

	operator *  (_ other: UInt8) -> UInt8 { return self.times(other) }
	operator *= (_ other: UInt8) { multiply(self, by: other) }

	operator /  (_ other: UInt8) -> UInt8 { return self.divided(by: other) }
	operator /= (_ other: UInt8) { divide(self, by: other) }

}