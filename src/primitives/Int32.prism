public func add(_ other: Int32, to: Int32) { to = to + other }

public func subtract(_ other: Int32, from: Int32) { from = from - other }

public func multiply(_ float: Int32, by: Int32) { float = float * by }

public func divide(_ float: Int32, by: Int32) { float = float / by }



module Int32 {

	0: data: @i32



	public func plus(_ other: Int32) -> Int32 { return @i32_plus(data, other.data) }

	public func minus(_ other: Int32) -> Int32 { return @i32_minus(data, other.data) }

	public func times(_ other: Int32) -> Int32 { return @i32_times(data, other.data) }

	public func divided(by: Int32) -> Int32 { return @i32_divided_by(data, other.data) }


	public func equals(_ other: Int32) -> Bool { return @i32_equals(data, other.data) }
	public func is_not(_ other: Int32) -> Bool { return @i32_is_not(data, other.data) }

	public func is_less_than(_ other: Int32) -> Bool { return @i32_is_less_than(data, other.data) }
	public func is_less_than_or_equal(_ other: Int32) -> Bool { return @i32_is_less_than_or_equal(data, other.data) }

	public func is_greater_than(_ other: Int32) -> Bool { return @i32_is_greater_than(data, other.data) }
	public func is_greater_than_or_equal(_ other: Int32) -> Bool { return @i32_is_greater_than_or_equal(data, other.data) }



	operator +  (other: Int32) -> Int32 { return self.plus(other) }
	operator += (other: Int32) { add(other, to: self) }

	operator -  (other: Int32) -> Int32 { return self.minus(other) }
	operator -= (other: Int32) { subtract(other, from: self) }

	operator *  (other: Int32) -> Int32 { return self.times(other) }
	operator *= (other: Int32) { multiply(self, by: other) }

	operator /  (other: Int32) -> Int32 { return self.divided(by: other) }
	operator /= (other: Int32) { divide(self, by: other) }


	operator == (other: Int32) -> Bool { return self.equals(other) }
	operator != (other: Int32) -> Bool { return self.is_not(other) }

	operator <  (other: Int32) -> Bool { return self.is_less_than(other) }
	operator <= (other: Int32) -> Bool { return self.is_less_than_or_equal(to: other) }

	operator <  (other: Int32) -> Bool { return self.is_greater_than(other) }
	operator <= (other: Int32) -> Bool { return self.is_greater_than_or_equal(to: other) }

}
