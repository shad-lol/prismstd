public func add(_ other: Uint16, to: Uint16) { to = to + other }

public func subtract(_ other: Uint16, from: Uint16) { from = from - other }

public func multiply(_ float: Uint16, by: Uint16) { float = float * by }

public func divide(_ float: Uint16, by: Uint16) { float = float / by }



module Uint16 {

	0: data: @u16



	public func plus(_ other: Uint16) -> Uint16 { return @u16_plus(data, other.data) }

	public func minus(_ other: Uint16) -> Uint16 { return @u16_minus(data, other.data) }

	public func times(_ other: Uint16) -> Uint16 { return @u16_times(data, other.data) }

	public func divided(by: Uint16) -> Uint16 { return @u16_divided_by(data, other.data) }


	public func equals(_ other: Uint16) -> Bool { return @u16_equals(data, other.data) }
	public func is_not(_ other: Uint16) -> Bool { return @u16_is_not(data, other.data) }

	public func is_less_than(_ other: Uint16) -> Bool { return @u16_is_less_than(data, other.data) }
	public func is_less_than_or_equal(_ other: Uint16) -> Bool { return @u16_is_less_than_or_equal(data, other.data) }

	public func is_greater_than(_ other: Uint16) -> Bool { return @u16_is_greater_than(data, other.data) }
	public func is_greater_than_or_equal(_ other: Uint16) -> Bool { return @u16_is_greater_than_or_equal(data, other.data) }



	operator +  (other: Uint16) -> Uint16 { return self.plus(other) }
	operator += (other: Uint16) { add(other, to: self) }

	operator -  (other: Uint16) -> Uint16 { return self.minus(other) }
	operator -= (other: Uint16) { subtract(other, from: self) }

	operator *  (other: Uint16) -> Uint16 { return self.times(other) }
	operator *= (other: Uint16) { multiply(self, by: other) }

	operator /  (other: Uint16) -> Uint16 { return self.divided(by: other) }
	operator /= (other: Uint16) { divide(self, by: other) }


	operator == (other: Uint16) -> Bool { return self.equals(other) }
	operator != (other: Uint16) -> Bool { return self.is_not(other) }

	operator <  (other: Uint16) -> Bool { return self.is_less_than(other) }
	operator <= (other: Uint16) -> Bool { return self.is_less_than_or_equal(to: other) }

	operator <  (other: Uint16) -> Bool { return self.is_greater_than(other) }
	operator <= (other: Uint16) -> Bool { return self.is_greater_than_or_equal(to: other) }

}
