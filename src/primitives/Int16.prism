public func add(_ other: Int16, to: Int16) { to = to + other }

public func subtract(_ other: Int16, from: Int16) { from = from - other }

public func multiply(_ float: Int16, by: Int16) { float = float * by }

public func divide(_ float: Int16, by: Int16) { float = float / by }



module Int16 {

	0: data: @i16



	public func plus(_ other: Int16) -> Int16 { return @i16_plus(data, other.data) }

	public func minus(_ other: Int16) -> Int16 { return @i16_minus(data, other.data) }

	public func times(_ other: Int16) -> Int16 { return @i16_times(data, other.data) }

	public func divided(by: Int16) -> Int16 { return @i16_divided_by(data, other.data) }



	operator +  (_ other: Int16) -> Int16 { return self.plus(other) }
	operator += (_ other: Int16) { add(other, to: self) }

	operator -  (_ other: Int16) -> Int16 { return self.minus(other) }
	operator -= (_ other: Int16) { subtract(other, from: self) }

	operator *  (_ other: Int16) -> Int16 { return self.times(other) }
	operator *= (_ other: Int16) { multiply(self, by: other) }

	operator /  (_ other: Int16) -> Int16 { return self.divided(by: other) }
	operator /= (_ other: Int16) { divide(self, by: other) }

}