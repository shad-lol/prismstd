public func add(_ other: Int64, to: Int64) { to = to + other }

public func subtract(_ other: Int64, from: Int64) { from = from - other }

public func multiply(_ float: Int64, by: Int64) { float = float * by }

public func divide(_ float: Int64, by: Int64) { float = float / by }



module Int64 {

	0: data: @i64



	public func plus(_ other: Int64) -> Int64 { return @i64_plus(data, other.data) }

	public func minus(_ other: Int64) -> Int64 { return @i64_minus(data, other.data) }

	public func times(_ other: Int64) -> Int64 { return @i64_times(data, other.data) }

	public func divided(by: Int64) -> Int64 { return @i64_divided_by(data, other.data) }



	operator +  (_ other: Int64) -> Int64 { return self.plus(other) }
	operator += (_ other: Int64) { add(other, to: self) }

	operator -  (_ other: Int64) -> Int64 { return self.minus(other) }
	operator -= (_ other: Int64) { subtract(other, from: self) }

	operator *  (_ other: Int64) -> Int64 { return self.times(other) }
	operator *= (_ other: Int64) { multiply(self, by: other) }

	operator /  (_ other: Int64) -> Int64 { return self.divided(by: other) }
	operator /= (_ other: Int64) { divide(self, by: other) }

}